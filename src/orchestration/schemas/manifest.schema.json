{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "webmcp.ai-orchestration-manifest/v0",
  "title": "Coordination manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "coordinationId", "fenceEpoch", "processGeneration", "createdAt"],
  "properties": {
    "schema": { "const": "webmcp.ai-orchestration-manifest/v0" },
    "coordinationId": { "type": "string", "pattern": "^coord_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$" },
    "fenceEpoch": { "type": "integer", "minimum": 1 },
    "processGeneration": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "owner": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "maxLength": 128 },
        "instanceId": { "type": "string", "maxLength": 128 }
      }
    }
  }
}
