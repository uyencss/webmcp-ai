{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "webmcp.ai-orchestration-delivery/v0",
  "title": "Ordered lifecycle Delivery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deliveryId", "sequence", "coordinationId", "type", "time", "payload"],
  "properties": {
    "schema": { "const": "webmcp.ai-orchestration-delivery/v0" },
    "deliveryId": { "type": "string", "pattern": "^del_" },
    "sequence": { "type": "integer", "minimum": 1 },
    "coordinationId": { "type": "string", "pattern": "^coord_" },
    "taskId": { "type": "string", "pattern": "^task_" },
    "dispatchId": { "type": "string", "pattern": "^disp_" },
    "bindingId": { "type": "string", "pattern": "^worker_" },
    "type": {
      "enum": [
        "coordination_created",
        "coordination_state_changed",
        "task_created",
        "task_state_changed",
        "dispatch_created",
        "dispatch_state_changed",
        "worker_binding_recorded",
        "worker_started",
        "heartbeat",
        "progress",
        "question",
        "reply",
        "escalation",
        "guidance",
        "permission_requested",
        "permission_resolved",
        "worker_done",
        "worker_failed",
        "worker_cancelled",
        "decision_gate_created",
        "decision_gate_resolved",
        "decision_gate_expired",
        "decision_gate_cancelled",
        "test_verdict_recorded",
        "acceptance_recorded",
        "ownership_transferred",
        "cleanup_recorded"
      ]
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "enum": ["coordinator", "worker", "kernel"] },
        "bindingId": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "enum": ["coordinator", "worker"] },
        "epoch": { "type": "integer", "minimum": 1 }
      }
    },
    "time": { "type": "string" },
    "payload": { "type": "object" }
  }
}
