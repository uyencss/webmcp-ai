{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "webmcp.ai-orchestration-request/v0",
  "title": "Coordinator IPC request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "requestId", "operation"],
  "properties": {
    "protocol": { "const": "webmcp.ai-orchestration/v0" },
    "requestId": { "type": "string", "pattern": "^req_[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$" },
    "operation": {
      "enum": [
        "coordination.inspect",
        "coordination.transfer",
        "coordination.close",
        "task.create",
        "task.cancel",
        "dispatch.start",
        "dispatch.reply",
        "dispatch.guidance",
        "dispatch.permission.resolve",
        "dispatch.interrupt",
        "dispatch.verify",
        "decision-gate.create",
        "decision-gate.resolve",
        "delivery.wait",
        "delivery.ack"
      ]
    },
    "coordinationId": { "type": "string", "pattern": "^coord_" },
    "fenceEpoch": { "type": "integer", "minimum": 1 },
    "capability": { "type": "string" },
    "input": { "type": "object" }
  },
  "notes": "Caller-supplied JSON must never include capability or fenceEpoch; the CLI injects them after parsing. They are accepted on the wire only from the trusted local CLI process."
}
