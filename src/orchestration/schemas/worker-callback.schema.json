{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "webmcp.ai-worker-callback/v0",
  "title": "One-Dispatch worker callback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "callbackId",
    "coordinationId",
    "taskId",
    "dispatchId",
    "bindingId",
    "fenceEpoch",
    "operation",
    "input",
    "callbackSeq"
  ],
  "properties": {
    "schema": {
      "const": "webmcp.ai-worker-callback/v0"
    },
    "callbackId": {
      "type": "string",
      "pattern": "^cbk_"
    },
    "coordinationId": {
      "type": "string",
      "pattern": "^coord_"
    },
    "taskId": {
      "type": "string",
      "pattern": "^task_"
    },
    "dispatchId": {
      "type": "string",
      "pattern": "^disp_"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^worker_"
    },
    "fenceEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "operation": {
      "enum": [
        "worker.heartbeat",
        "worker.progress",
        "worker.question",
        "worker.escalation",
        "worker.terminal"
      ]
    },
    "input": {
      "type": "object"
    },
    "callbackSeq": {
      "type": "integer",
      "minimum": 1
    }
  }
}
